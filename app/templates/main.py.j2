"""FastAPI application entrypoint, generated from the specification."""

from fastapi import FastAPI, Depends, HTTPException
from fastapi.responses import HTMLResponse
from sqlalchemy.orm import Session
import os

import models
import schemas
import services
from database import engine, get_db, Base
{% if auth_enabled %}
from security import get_current_user, create_access_token, authenticate_demo_user
{% endif %}

Base.metadata.create_all(bind=engine)

app = FastAPI(title="{{ app_name }}")


@app.get("/", response_class=HTMLResponse)
def frontend():
    path = os.path.join(os.path.dirname(__file__), "frontend.html")
    with open(path, encoding="utf-8") as f:
        return f.read()

{% if auth_enabled %}
@app.post("/token")
def login(username: str, password: str):
    if not authenticate_demo_user(username, password):
        raise HTTPException(status_code=401, detail="Invalid credentials")
    token = create_access_token({"sub": username})
    return {"access_token": token, "token_type": "bearer"}

{% endif %}
{# Pass 1: exact-path routes only (POST create, GET list) -- safe, no path-param conflicts #}
{% for entity in entities %}
{% if entity.has_create %}
@app.post("{{ entity.create_path }}", response_model=schemas.{{ entity.class_name }}Read, status_code=201{% if entity.create_protected and auth_enabled %}, dependencies=[Depends(get_current_user)]{% endif %})
def create_{{ entity.var_name }}(obj_in: schemas.{{ entity.class_name }}Create, db: Session = Depends(get_db)):
    return services.create_{{ entity.var_name }}(db, obj_in)

{% endif %}
{% if entity.has_list %}
@app.get("{{ entity.list_path }}", response_model=list[schemas.{{ entity.class_name }}Read])
def list_{{ entity.var_name }}(skip: int = 0, limit: int = 100, db: Session = Depends(get_db)):
    return services.get_{{ entity.var_name }}_list(db, skip, limit)

{% endif %}
{% endfor %}
{# Pass 2: custom endpoints -- mostly exact/literal paths (e.g. /products/low-stock). #}
{# Must be registered before Pass 3's parameterized routes or FastAPI will match #}
{# the parameterized route first and misinterpret the literal segment as an id. #}
{% for ep in custom_endpoints %}
# LLM_IMPLEMENT[{{ ep.func_name }}]: {{ ep.description }}
@app.{{ ep.method_lower }}("{{ ep.path }}"{% if ep.protected and auth_enabled %}, dependencies=[Depends(get_current_user)]{% endif %})
def {{ ep.func_name }}(db: Session = Depends(get_db)):
    raise HTTPException(status_code=501, detail="Not implemented yet -- Day 4 Coding Agent fills this in")

{% endfor %}
{# Pass 3: parameterized routes (GET one, PUT, DELETE) -- registered last so they #}
{# never shadow a more specific literal path from Pass 2. #}
{% for entity in entities %}
{% if entity.has_get_one %}
@app.get("{{ entity.get_one_path }}", response_model=schemas.{{ entity.class_name }}Read)
def get_{{ entity.var_name }}({{ entity.var_name }}_id: int, db: Session = Depends(get_db)):
    obj = services.get_{{ entity.var_name }}(db, {{ entity.var_name }}_id)
    if obj is None:
        raise HTTPException(status_code=404, detail="{{ entity.class_name }} not found")
    return obj

{% endif %}
{% if entity.has_update %}
@app.put("{{ entity.update_path }}", response_model=schemas.{{ entity.class_name }}Read{% if entity.update_protected and auth_enabled %}, dependencies=[Depends(get_current_user)]{% endif %})
def update_{{ entity.var_name }}({{ entity.var_name }}_id: int, obj_in: schemas.{{ entity.class_name }}Update, db: Session = Depends(get_db)):
    obj = services.update_{{ entity.var_name }}(db, {{ entity.var_name }}_id, obj_in)
    if obj is None:
        raise HTTPException(status_code=404, detail="{{ entity.class_name }} not found")
    return obj

{% endif %}
{% if entity.has_delete %}
@app.delete("{{ entity.delete_path }}", status_code=204{% if entity.delete_protected and auth_enabled %}, dependencies=[Depends(get_current_user)]{% endif %})
def delete_{{ entity.var_name }}({{ entity.var_name }}_id: int, db: Session = Depends(get_db)):
    deleted = services.delete_{{ entity.var_name }}(db, {{ entity.var_name }}_id)
    if not deleted:
        raise HTTPException(status_code=404, detail="{{ entity.class_name }} not found")
    return None

{% endif %}
{% endfor %}
