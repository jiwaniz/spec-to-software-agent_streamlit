<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>{{ app_name }}</title>
<style>
  body { font-family: sans-serif; max-width: 1000px; margin: 2rem auto; padding: 0 1rem; color: #222; }
  h1 { color: #333; }
  section { margin-bottom: 2.5rem; border: 1px solid #ddd; border-radius: 8px; padding: 1rem; }
  table { width: 100%; border-collapse: collapse; margin-top: 0.5rem; }
  th, td { text-align: left; padding: 6px 8px; border-bottom: 1px solid #eee; font-size: 14px; }
  th { background: #f5f5f5; cursor: pointer; user-select: none; }
  th:hover { background: #eaeaea; }
  tr.low-stock { background: #fff0f0; }
  form { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 0.75rem; align-items: end; }
  form label { display: flex; flex-direction: column; font-size: 12px; color: #555; }
  input { padding: 4px 6px; }
  button { padding: 6px 12px; cursor: pointer; }
  .delete-btn { background: #e74c3c; color: white; border: none; border-radius: 4px; }
  .toolbar { display: flex; gap: 10px; align-items: center; margin-bottom: 6px; }
  .stat-cards { display: flex; gap: 12px; flex-wrap: wrap; }
  .stat-card { background: #f7f7fb; border: 1px solid #e0e0ea; border-radius: 8px; padding: 10px 16px; min-width: 140px; }
  .stat-card .num { font-size: 22px; font-weight: bold; }
  .stat-card .label { font-size: 12px; color: #666; }
  .bar-row { display: flex; align-items: center; gap: 8px; margin: 4px 0; font-size: 13px; }
  .bar-track { background: #eee; border-radius: 4px; flex: 1; height: 14px; overflow: hidden; }
  .bar-fill { background: #4a7dfc; height: 100%; }
  .bar-label { width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>
</head>
<body>
<h1>{{ app_name }}</h1>
<p><a href="/docs" target="_blank">API docs (Swagger)</a></p>

{% for entity in entities %}
{% if entity.has_list %}
<section>
  <h2>{{ entity.class_name }}</h2>

  <div class="stat-cards" id="{{ entity.table_name }}-stats"></div>

  {% if entity.quantity_field %}
  <div id="{{ entity.table_name }}-chart" style="margin-top:12px;"></div>
  {% endif %}

  <div class="toolbar" style="margin-top:12px;">
    <input type="text" id="{{ entity.table_name }}-search" placeholder="Search...">
    {% if entity.quantity_field and entity.threshold_field %}
    <label style="flex-direction:row; gap:4px; align-items:center;">
      <input type="checkbox" id="{{ entity.table_name }}-lowstock-only"> Low stock only
    </label>
    {% endif %}
  </div>

  <table>
    <thead><tr>
      <th onclick="sortBy_{{ entity.var_name }}('id')">id</th>
      {% for field in entity.fields %}<th onclick="sortBy_{{ entity.var_name }}('{{ field.name }}')">{{ field.name }}</th>{% endfor %}
      {% if entity.has_delete %}<th>Actions</th>{% endif %}
    </tr></thead>
    <tbody id="{{ entity.table_name }}-body"></tbody>
  </table>

  {% if entity.has_create %}
  <form id="{{ entity.table_name }}-form">
    {% for field in entity.fields %}
    <label>{{ field.name }}
      <input name="{{ field.name }}" type="{% if field.py_type in ['int','float'] %}number{% elif field.py_type == 'bool' %}checkbox{% elif field.py_type == 'datetime' %}datetime-local{% else %}text{% endif %}" {% if field.py_type == 'float' %}step="any"{% endif %}>
    </label>
    {% endfor %}
    <button type="submit">Add {{ entity.class_name }}</button>
  </form>
  {% endif %}
</section>
{% endif %}
{% endfor %}

<script>
{% for entity in entities %}
{% if entity.has_list %}
let _{{ entity.var_name }}_data = [];
let _{{ entity.var_name }}_sort = { field: null, asc: true };

async function load_{{ entity.var_name }}() {
  const res = await fetch("/{{ entity.table_name }}");
  _{{ entity.var_name }}_data = await res.json();
  render_{{ entity.var_name }}();
}

function sortBy_{{ entity.var_name }}(field) {
  const s = _{{ entity.var_name }}_sort;
  s.asc = (s.field === field) ? !s.asc : true;
  s.field = field;
  render_{{ entity.var_name }}();
}

function render_{{ entity.var_name }}() {
  let rows = [..._{{ entity.var_name }}_data];

  const search = document.getElementById("{{ entity.table_name }}-search").value.toLowerCase();
  if (search) {
    rows = rows.filter(r => Object.values(r).some(v => String(v).toLowerCase().includes(search)));
  }

  {% if entity.quantity_field and entity.threshold_field %}
  const lowOnly = document.getElementById("{{ entity.table_name }}-lowstock-only").checked;
  if (lowOnly) {
    rows = rows.filter(r => r["{{ entity.quantity_field }}"] < r["{{ entity.threshold_field }}"]);
  }
  {% endif %}

  const s = _{{ entity.var_name }}_sort;
  if (s.field) {
    rows.sort((a, b) => {
      const av = a[s.field], bv = b[s.field];
      if (av === bv) return 0;
      const cmp = av > bv ? 1 : -1;
      return s.asc ? cmp : -cmp;
    });
  }

  const body = document.getElementById("{{ entity.table_name }}-body");
  body.innerHTML = "";
  rows.forEach(row => {
    const tr = document.createElement("tr");
    {% if entity.quantity_field and entity.threshold_field %}
    if (row["{{ entity.quantity_field }}"] < row["{{ entity.threshold_field }}"]) tr.className = "low-stock";
    {% endif %}
    let cells = "<td>" + row.id + "</td>";
    {% for field in entity.fields %}
    cells += "<td>" + (row["{{ field.name }}"] ?? "") + "</td>";
    {% endfor %}
    {% if entity.has_delete %}
    cells += '<td><button class="delete-btn" onclick="delete_{{ entity.var_name }}(' + row.id + ')">Delete</button></td>';
    {% endif %}
    tr.innerHTML = cells;
    body.appendChild(tr);
  });

  renderStats_{{ entity.var_name }}(_{{ entity.var_name }}_data);
}

function renderStats_{{ entity.var_name }}(all) {
  const stats = document.getElementById("{{ entity.table_name }}-stats");
  let cards = '<div class="stat-card"><div class="num">' + all.length + '</div><div class="label">Total {{ entity.class_name }}</div></div>';
  {% if entity.price_field and entity.quantity_field %}
  const totalValue = all.reduce((sum, r) => sum + (r["{{ entity.price_field }}"] || 0) * (r["{{ entity.quantity_field }}"] || 0), 0);
  cards += '<div class="stat-card"><div class="num">' + totalValue.toFixed(2) + '</div><div class="label">Total Value</div></div>';
  {% endif %}
  {% if entity.quantity_field and entity.threshold_field %}
  const lowCount = all.filter(r => r["{{ entity.quantity_field }}"] < r["{{ entity.threshold_field }}"]).length;
  cards += '<div class="stat-card"><div class="num">' + lowCount + '</div><div class="label">Low Stock Items</div></div>';
  {% endif %}
  stats.innerHTML = cards;

  {% if entity.quantity_field %}
  const chartEl = document.getElementById("{{ entity.table_name }}-chart");
  const top = [...all].sort((a,b) => (b["{{ entity.quantity_field }}"]||0) - (a["{{ entity.quantity_field }}"]||0)).slice(0, 8);
  const maxVal = Math.max(1, ...top.map(r => r["{{ entity.quantity_field }}"] || 0));
  chartEl.innerHTML = top.map(r => {
    const val = r["{{ entity.quantity_field }}"] || 0;
    const pct = Math.round((val / maxVal) * 100);
    const label = r.name || r.id;
    return '<div class="bar-row"><div class="bar-label">' + label + '</div><div class="bar-track"><div class="bar-fill" style="width:' + pct + '%"></div></div><div>' + val + '</div></div>';
  }).join("");
  {% endif %}
}

document.getElementById("{{ entity.table_name }}-search").addEventListener("input", render_{{ entity.var_name }});
{% if entity.quantity_field and entity.threshold_field %}
document.getElementById("{{ entity.table_name }}-lowstock-only").addEventListener("change", render_{{ entity.var_name }});
{% endif %}

{% if entity.has_create %}
document.getElementById("{{ entity.table_name }}-form").addEventListener("submit", async (e) => {
  e.preventDefault();
  const form = e.target;
  const payload = {};
  {% for field in entity.fields %}
  {% if field.py_type == 'bool' %}
  payload["{{ field.name }}"] = form["{{ field.name }}"].checked;
  {% elif field.py_type in ['int', 'float'] %}
  payload["{{ field.name }}"] = form["{{ field.name }}"].value === "" ? null : Number(form["{{ field.name }}"].value);
  {% else %}
  payload["{{ field.name }}"] = form["{{ field.name }}"].value;
  {% endif %}
  {% endfor %}
  const res = await fetch("/{{ entity.table_name }}", {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify(payload),
  });
  if (res.ok) { form.reset(); load_{{ entity.var_name }}(); }
  else { alert("Error: " + await res.text()); }
});
{% endif %}

{% if entity.has_delete %}
async function delete_{{ entity.var_name }}(id) {
  await fetch("/{{ entity.table_name }}/" + id, { method: "DELETE" });
  load_{{ entity.var_name }}();
}
{% endif %}

load_{{ entity.var_name }}();
{% endif %}
{% endfor %}
</script>
</body>
</html>
