<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>{{ app_name }}</title>
<style>
  :root { --accent1:#6C5CE7; --accent2:#00B894; --accent3:#FD79A8; --accent4:#0984E3; --bg:#F7F7FC; }
  body { font-family: 'Segoe UI', sans-serif; max-width: 1050px; margin: 0 auto; padding: 0 1rem 2rem; background: var(--bg); color: #2d2d3a; }
  .header { background: linear-gradient(135deg, var(--accent1), var(--accent4)); color: white; padding: 1.5rem 2rem; margin: 0 -1rem 1.5rem; border-radius: 0 0 16px 16px; }
  .header h1 { margin: 0 0 4px; }
  .header a { color: #e8e8ff; }
  .tabs { display: flex; gap: 8px; margin-bottom: 1.5rem; }
  .tab-btn { padding: 10px 20px; border: none; border-radius: 8px 8px 0 0; background: #e2e2ee; cursor: pointer; font-weight: 600; color: #555; }
  .tab-btn.active { background: white; color: var(--accent1); box-shadow: 0 -2px 6px rgba(0,0,0,0.05); }
  .view { display: none; }
  .view.active { display: block; }
  section { margin-bottom: 2rem; background: white; border-radius: 12px; padding: 1.2rem; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
  section h2 { margin-top: 0; color: var(--accent1); }
  table { width: 100%; border-collapse: collapse; margin-top: 0.5rem; }
  th, td { text-align: left; padding: 8px; border-bottom: 1px solid #eee; font-size: 14px; }
  th { background: #f0f0fa; cursor: pointer; color: #555; }
  th:hover { background: #e6e6f5; }
  tr.low-stock { background: #ffecec; }
  form { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 0.75rem; align-items: end; }
  form label { display: flex; flex-direction: column; font-size: 12px; color: #666; }
  input { padding: 6px 8px; border: 1px solid #ddd; border-radius: 6px; }
  button { padding: 8px 16px; cursor: pointer; border: none; border-radius: 6px; background: var(--accent1); color: white; font-weight: 600; }
  button:hover { opacity: 0.9; }
  .delete-btn { background: var(--accent3); }
  .toolbar { display: flex; gap: 12px; align-items: center; margin-bottom: 6px; }
  .toolbar input { flex: 1; }
  .stat-cards { display: flex; gap: 14px; flex-wrap: wrap; }
  .stat-card { color: white; border-radius: 10px; padding: 14px 20px; min-width: 150px; }
  .stat-card:nth-child(4n+1) { background: linear-gradient(135deg, var(--accent1), #a29bfe); }
  .stat-card:nth-child(4n+2) { background: linear-gradient(135deg, var(--accent2), #55efc4); }
  .stat-card:nth-child(4n+3) { background: linear-gradient(135deg, var(--accent3), #fab1c9); }
  .stat-card:nth-child(4n+4) { background: linear-gradient(135deg, var(--accent4), #74b9ff); }
  .stat-card .num { font-size: 26px; font-weight: bold; }
  .stat-card .label { font-size: 12px; opacity: 0.9; }
  .bar-row { display: flex; align-items: center; gap: 8px; margin: 5px 0; font-size: 13px; }
  .bar-track { background: #eee; border-radius: 4px; flex: 1; height: 16px; overflow: hidden; }
  .bar-fill { background: linear-gradient(90deg, var(--accent1), var(--accent4)); height: 100%; }
  .bar-label { width: 120px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
</style>
</head>
<body>
<div class="header">
  <h1>{{ app_name }}</h1>
  <a href="/docs" target="_blank">API docs (Swagger)</a>
</div>

<div class="tabs">
{% for tab in ui_plan %}
  <button class="tab-btn{% if loop.first %} active{% endif %}" onclick="showTab('{{ tab.id }}', this)">{{ tab.label }}</button>
{% endfor %}
</div>

{% for tab in ui_plan %}
<div id="view-{{ tab.id }}" class="view{% if loop.first %} active{% endif %}">

{% if tab.type == 'entry' %}
{% for entity in tab.entities %}
<section>
  <h2>{{ entity.class_name }}</h2>
  <div class="toolbar">
    <input type="text" id="{{ entity.table_name }}-search" placeholder="Search {{ entity.class_name }}...">
  </div>
  <table>
    <thead><tr>
      <th onclick="sortBy_{{ entity.var_name }}('id')">id</th>
      {% for field in entity.fields %}<th onclick="sortBy_{{ entity.var_name }}('{{ field.name }}')">{{ field.name }}</th>{% endfor %}
      {% if entity.has_delete %}<th>Actions</th>{% endif %}
    </tr></thead>
    <tbody id="{{ entity.table_name }}-body"></tbody>
  </table>
  {% if entity.has_create %}
  <form id="{{ entity.table_name }}-form">
    {% for field in entity.fields %}
    <label>{{ field.name }}
      <input name="{{ field.name }}" type="{% if field.py_type in ['int','float'] %}number{% elif field.py_type == 'bool' %}checkbox{% elif field.py_type == 'datetime' %}datetime-local{% else %}text{% endif %}" {% if field.py_type == 'float' %}step="any"{% endif %}>
    </label>
    {% endfor %}
    <button type="submit">Add {{ entity.class_name }}</button>
  </form>
  {% endif %}
</section>
{% endfor %}

{% elif tab.type == 'reports' %}
{% for entity in tab.entities %}
<section>
  <h2>{{ entity.class_name }} Report</h2>
  <div class="stat-cards" id="{{ entity.table_name }}-stats"></div>
  {% if entity.quantity_field %}
  <div id="{{ entity.table_name }}-chart" style="margin-top:14px;"></div>
  {% endif %}
  {% if entity.price_field and entity.date_field %}
  <h3 id="{{ entity.table_name }}-monthly-title" style="margin-top:16px; font-size:14px; color:#666;"></h3>
  <div id="{{ entity.table_name }}-monthly-chart"></div>
  <h3 id="{{ entity.table_name }}-yearly-title" style="margin-top:16px; font-size:14px; color:#666;"></h3>
  <div id="{{ entity.table_name }}-yearly-chart"></div>
  {% endif %}
  {% if entity.price_field %}
  {% for fk in entity.fk_breakdowns %}
  <h3 id="{{ entity.table_name }}-by-{{ fk.target_var }}-title" style="margin-top:16px; font-size:14px; color:#666;"></h3>
  <div id="{{ entity.table_name }}-by-{{ fk.target_var }}-chart"></div>
  {% endfor %}
  {% endif %}
</section>
{% endfor %}

{% elif tab.type == 'alerts' %}
{% for entity in tab.entities %}
<section>
  <h2>{{ entity.class_name }} -- Low Stock</h2>
  <table>
    <thead><tr><th>id</th>{% for field in entity.fields %}<th>{{ field.name }}</th>{% endfor %}</tr></thead>
    <tbody id="{{ entity.table_name }}-alerts-body"></tbody>
  </table>
</section>
{% endfor %}

{% elif tab.type == 'settings' %}
<section>
  <h2>Authentication</h2>
  <p>Demo login (change before real use): <code>POST /token</code> with <code>username=admin&password=admin</code></p>
  <p>Use the returned token as <code>Authorization: Bearer &lt;token&gt;</code> on protected requests.</p>
</section>
{% endif %}

</div>
{% endfor %}

<script>
function showTab(name, btn) {
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('view-' + name).classList.add('active');
  btn.classList.add('active');
}

{% for entity in entities %}
{% if entity.has_list %}
let _{{ entity.var_name }}_data = [];
let _{{ entity.var_name }}_sort = { field: null, asc: true };

async function load_{{ entity.var_name }}() {
  const res = await fetch("/{{ entity.table_name }}");
  _{{ entity.var_name }}_data = await res.json();
}

function sortBy_{{ entity.var_name }}(field) {
  const s = _{{ entity.var_name }}_sort;
  s.asc = (s.field === field) ? !s.asc : true;
  s.field = field;
  render_{{ entity.var_name }}();
}

function render_{{ entity.var_name }}() {
  let rows = [..._{{ entity.var_name }}_data];
  const searchEl = document.getElementById("{{ entity.table_name }}-search");
  const search = searchEl ? searchEl.value.toLowerCase() : "";
  if (search) rows = rows.filter(r => Object.values(r).some(v => String(v).toLowerCase().includes(search)));
  const s = _{{ entity.var_name }}_sort;
  if (s.field) rows.sort((a,b) => { const av=a[s.field], bv=b[s.field]; if(av===bv) return 0; const c=av>bv?1:-1; return s.asc?c:-c; });

  const body = document.getElementById("{{ entity.table_name }}-body");
  if (body) {
    body.innerHTML = "";
    rows.forEach(row => {
      const tr = document.createElement("tr");
      {% if entity.quantity_field and entity.threshold_field %}
      if (row["{{ entity.quantity_field }}"] < row["{{ entity.threshold_field }}"]) tr.className = "low-stock";
      {% endif %}
      let cells = "<td>" + row.id + "</td>";
      {% for field in entity.fields %}cells += "<td>" + (row["{{ field.name }}"] ?? "") + "</td>";{% endfor %}
      {% if entity.has_delete %}cells += '<td><button class="delete-btn" onclick="delete_{{ entity.var_name }}(' + row.id + ')">Delete</button></td>';{% endif %}
      tr.innerHTML = cells;
      body.appendChild(tr);
    });
  }

  {% if entity.quantity_field and entity.threshold_field %}
  const alertsBody = document.getElementById("{{ entity.table_name }}-alerts-body");
  if (alertsBody) {
    alertsBody.innerHTML = "";
    _{{ entity.var_name }}_data.filter(r => r["{{ entity.quantity_field }}"] < r["{{ entity.threshold_field }}"]).forEach(row => {
      const tr = document.createElement("tr");
      let cells = "<td>" + row.id + "</td>";
      {% for field in entity.fields %}cells += "<td>" + (row["{{ field.name }}"] ?? "") + "</td>";{% endfor %}
      tr.innerHTML = cells;
      alertsBody.appendChild(tr);
    });
  }
  {% endif %}

  if (document.getElementById("{{ entity.table_name }}-stats")) renderStats_{{ entity.var_name }}(_{{ entity.var_name }}_data);
}

function renderStats_{{ entity.var_name }}(all) {
  const stats = document.getElementById("{{ entity.table_name }}-stats");
  let cards = '<div class="stat-card"><div class="num">' + all.length + '</div><div class="label">Total {{ entity.class_name }}</div></div>';
  {% if entity.price_field and entity.quantity_field %}
  const totalValue = all.reduce((s,r) => s + (r["{{ entity.price_field }}"]||0) * (r["{{ entity.quantity_field }}"]||0), 0);
  cards += '<div class="stat-card"><div class="num">' + totalValue.toFixed(2) + '</div><div class="label">Total Value</div></div>';
  {% elif entity.price_field %}
  const totalSum = all.reduce((s,r) => s + (r["{{ entity.price_field }}"]||0), 0);
  cards += '<div class="stat-card"><div class="num">' + totalSum.toFixed(2) + '</div><div class="label">Total {{ entity.price_field }}</div></div>';
  {% endif %}
  {% if entity.quantity_field and entity.threshold_field %}
  const lowCount = all.filter(r => r["{{ entity.quantity_field }}"] < r["{{ entity.threshold_field }}"]).length;
  cards += '<div class="stat-card"><div class="num">' + lowCount + '</div><div class="label">Low Stock Items</div></div>';
  {% endif %}
  stats.innerHTML = cards;

  {% if entity.quantity_field %}
  renderBarChart_{{ entity.var_name }}(document.getElementById("{{ entity.table_name }}-chart"),
    [...all].sort((a,b) => (b["{{ entity.quantity_field }}"]||0)-(a["{{ entity.quantity_field }}"]||0)).slice(0,8).map(r => [r.name || r.id, r["{{ entity.quantity_field }}"]||0]));
  {% endif %}

  {% if entity.price_field and entity.date_field %}
  const byMonth = {}, byYear = {};
  all.forEach(r => {
    const d = r["{{ entity.date_field }}"];
    if (!d) return;
    const month = String(d).slice(0,7), year = String(d).slice(0,4);
    byMonth[month] = (byMonth[month]||0) + (r["{{ entity.price_field }}"]||0);
    byYear[year] = (byYear[year]||0) + (r["{{ entity.price_field }}"]||0);
  });
  document.getElementById("{{ entity.table_name }}-monthly-title").textContent = "By Month";
  renderBarChart_{{ entity.var_name }}(document.getElementById("{{ entity.table_name }}-monthly-chart"), Object.entries(byMonth).sort());
  document.getElementById("{{ entity.table_name }}-yearly-title").textContent = "By Year";
  renderBarChart_{{ entity.var_name }}(document.getElementById("{{ entity.table_name }}-yearly-chart"), Object.entries(byYear).sort());
  {% endif %}

  {% if entity.price_field %}
  {% for fk in entity.fk_breakdowns %}
  {
    const byLabel = {};
    all.forEach(r => {
      const target = (_{{ fk.target_var }}_data || []).find(t => t.id === r["{{ fk.field_name }}"]);
      const label = target ? (target["{{ fk.label_field }}"] ?? ("id " + target.id)) : "Unknown";
      byLabel[label] = (byLabel[label]||0) + (r["{{ entity.price_field }}"]||0);
    });
    document.getElementById("{{ entity.table_name }}-by-{{ fk.target_var }}-title").textContent = "By {{ fk.target_class }}";
    renderBarChart_{{ entity.var_name }}(document.getElementById("{{ entity.table_name }}-by-{{ fk.target_var }}-chart"), Object.entries(byLabel).sort((a,b) => b[1]-a[1]));
  }
  {% endfor %}
  {% endif %}
}

function renderBarChart_{{ entity.var_name }}(el, pairs) {
  if (!el) return;
  const maxVal = Math.max(1, ...pairs.map(p => p[1]));
  el.innerHTML = pairs.map(([label, val]) => {
    const pct = Math.round((val/maxVal)*100);
    return '<div class="bar-row"><div class="bar-label">'+label+'</div><div class="bar-track"><div class="bar-fill" style="width:'+pct+'%"></div></div><div>'+ (typeof val === 'number' ? val.toFixed(2) : val) +'</div></div>';
  }).join("");
}

const _{{ entity.var_name }}_searchEl = document.getElementById("{{ entity.table_name }}-search");
if (_{{ entity.var_name }}_searchEl) _{{ entity.var_name }}_searchEl.addEventListener("input", render_{{ entity.var_name }});

{% if entity.has_create %}
document.getElementById("{{ entity.table_name }}-form").addEventListener("submit", async (e) => {
  e.preventDefault();
  const form = e.target, payload = {};
  {% for field in entity.fields %}
  {% if field.py_type == 'bool' %}payload["{{ field.name }}"] = form["{{ field.name }}"].checked;
  {% elif field.py_type in ['int','float'] %}payload["{{ field.name }}"] = form["{{ field.name }}"].value === "" ? null : Number(form["{{ field.name }}"].value);
  {% else %}payload["{{ field.name }}"] = form["{{ field.name }}"].value;{% endif %}
  {% endfor %}
  const res = await fetch("/{{ entity.table_name }}", { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify(payload) });
  if (res.ok) { form.reset(); await load_{{ entity.var_name }}(); render_{{ entity.var_name }}(); }
  else { alert("Error: " + await res.text()); }
});
{% endif %}

{% if entity.has_delete %}
async function delete_{{ entity.var_name }}(id) {
  await fetch("/{{ entity.table_name }}/" + id, { method: "DELETE" });
  await load_{{ entity.var_name }}();
  render_{{ entity.var_name }}();
}
{% endif %}
{% endif %}
{% endfor %}

{% set listable = entities | selectattr('has_list') | list %}
Promise.all([{% for entity in listable %}load_{{ entity.var_name }}(){% if not loop.last %}, {% endif %}{% endfor %}]).then(() => {
  {% for entity in listable %}render_{{ entity.var_name }}();
  {% endfor %}
});
</script>
</body>
</html>
